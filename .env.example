# CCS Sit-in Monitoring System - Environment Configuration Example
# Copy this file to '.env' and fill in your actual credentials.

# 1. DATABASE_URL:
# For local SQLite, leave this commented out or empty.
# For Turso Cloud Database, use your Turso DB Connection URL (e.g., libsql://your-db-name-user.turso.io)
DATABASE_URL=libsql://your-database-name.turso.io

# 2. DATABASE_AUTH_TOKEN:
# For local SQLite, leave this commented out or empty.
# For Turso Cloud Database, paste your database Auth token here.
DATABASE_AUTH_TOKEN=your-turso-jwt-access-token-here

# 3. PORT (Optional):
# Local development server port (defaults to 3000)
PORT=3000
